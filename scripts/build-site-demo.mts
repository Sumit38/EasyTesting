/**
 * Records a real run of the sample use case for the landing page's interactive demo.
 *   node --import tsx scripts/build-site-demo.mts
 * Writes site/demo-data.js. Nothing in it is made up: the cases come from the generator, the step readings from the
 * step reader, and the runs from the real executor against the sample sign-in page (healthy, then after a release).
 */
import { mkdtempSync, writeFileSync } from 'node:fs';
import { createServer } from 'node:http';
import type { AddressInfo } from 'node:net';
import { tmpdir } from 'node:os';
import { join, resolve } from 'node:path';
import { loadRecords } from '../src/apply.js';
import { generateCases } from '../src/cases/generate.js';
import { describeStep, parseStep } from '../src/cases/steps.js';
import { runCases, type CaseResult } from '../src/exec/runner.js';
import { DEMO_TEST_DATA, DEMO_USE_CASE, demoPage } from '../src/server/demo.js';

const site = createServer((req, res) => {
  const u = new URL(req.url ?? '/', 'http://x');
  const page = demoPage(u.pathname, u.searchParams.get('v') ?? '1');
  res.writeHead(page ? 200 : 404, { 'content-type': 'text/html' });
  res.end(page ?? 'not found');
});
await new Promise<void>((r) => site.listen(0, '127.0.0.1', r));
const origin = `http://127.0.0.1:${(site.address() as AddressInfo).port}`;

const gen = generateCases(DEMO_USE_CASE, { testData: DEMO_TEST_DATA });
const dir = mkdtempSync(join(tmpdir(), 'site-demo-'));
const store = join(dir, 'fp.db');

const slim = (results: CaseResult[]) =>
  results.map((r) => ({
    id: r.id, status: r.status, confidence: r.confidence,
    steps: r.steps.map((s) => ({ status: s.status, ms: Math.round(s.ms), via: s.via ?? null, confidence: Math.round(s.confidence * 100) })),
  }));

const first = await runCases({ cases: gen.cases, appUrl: `${origin}/demo/login?v=1`, healDir: join(dir, 'r1'), storeFile: store, stepTimeout: 6000 });
const second = await runCases({ cases: gen.cases, appUrl: `${origin}/demo/login?v=2`, healDir: join(dir, 'r2'), storeFile: store, stepTimeout: 6000 });
const heals = loadRecords(join(dir, 'r2'));
const seen = new Set<string>();
const healList = heals
  .filter((h) => h.newSelector && !seen.has(h.oldSelector + h.newSelector) && seen.add(h.oldSelector + h.newSelector))
  .map((h) => ({
    was: h.oldSelector, now: h.newSelector, confidence: Math.round(h.confidence * 100), verdict: h.verdict,
    element: h.matched ? `${h.matched.role !== 'generic' ? h.matched.role + ' ' : ''}"${h.matched.name || h.matched.text}"` : '',
  }));

const data = {
  recordedFrom: 'A real run of EasyTesting on its own sample sign-in page',
  useCase: DEMO_USE_CASE,
  cases: gen.cases.map((c) => ({
    id: c.id, title: c.title.replace(/^Sign in to Acme: /, ''), type: c.type, basis: c.basis, expected: c.expected,
    steps: c.steps.map((text) => {
      const p = parseStep(text);
      return { text, read: describeStep(p), action: p.action, confidence: Math.round(p.confidence * 100) };
    }),
  })),
  notes: gen.notes,
  run1: slim(first.results),
  run2: slim(second.results),
  heals: healList,
  summary: {
    run1: { passed: first.results.filter((r) => r.status === 'passed').length, total: first.results.length },
    run2: { passed: second.results.filter((r) => r.status === 'passed').length, total: second.results.length },
  },
};

const out = resolve('site', 'demo-data.js');
writeFileSync(out, `// Generated by scripts/build-site-demo.mts from a real run. Do not edit by hand.\nwindow.EASY_DEMO = ${JSON.stringify(data, null, 1)};\n`);
console.log(`Wrote ${out}: ${data.cases.length} cases, run 1 ${data.summary.run1.passed}/${data.summary.run1.total} passed, run 2 ${data.summary.run2.passed}/${data.summary.run2.total} passed, ${healList.length} healed locators`);
site.close();
process.exit(0);

{
  "name": "easytesting",
  "version": "0.1.0",
  "description": "EasyTesting: describe what your app should do, get test cases, run them in a real browser, and let broken locators heal themselves (Playwright and Selenium).",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "serve": "node --import tsx src/cli.ts serve"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@playwright/test": "^1.56.1",
    "fflate": "^0.8.3",
    "playwright-core": "1.56.1"
  },
  "peerDependencies": {
    "selenium-webdriver": ">=4"
  },
  "peerDependenciesMeta": {
    "selenium-webdriver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/selenium-webdriver": "^4.35.7",
    "selenium-webdriver": "^4.50.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  },
  "bin": {
    "easytesting": "dist/cli.js",
    "heal": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./selenium": {
      "types": "./dist/selenium.d.ts",
      "default": "./dist/selenium.js"
    }
  }
}
